{
  "name": "zetho-api",
  "version": "0.14.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "gameplay:dedupe-participants": "ts-node scripts/dedupe-gameplay-session-participants.ts",
    "social:backfill-entry-counters": "ts-node scripts/backfill-entry-social-counters.ts",
    "email:sync-templates": "ts-node scripts/sync-email-templates.ts",
    "games:backfill": "ts-node -r tsconfig-paths/register scripts/backfill-game-search.ts",
    "games:search-audit": "ts-node -r tsconfig-paths/register scripts/audit-game-search-backfill.ts",
    "mcp": "ts-node -r tsconfig-paths/register src/mcp.ts",
    "mcp:prod": "node dist/mcp",
    "deploy": "dotenv -e .env -- sh -c 'curl -f -s -X GET \"$DEPLOYMENT_TRIGGER_ENDPOINT\"'",
    "social:backfill-feed": "ts-node -r tsconfig-paths/register scripts/backfill-feed-events.ts",
    "appwrite:provision-012": "dotenv -e .env -- node scripts/provision-appwrite-012.js"
  },
  "dependencies": {
    "@genkit-ai/compat-oai": "^1.33.0",
    "@genkit-ai/google-genai": "^1.33.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@xmldom/xmldom": "^0.9.10",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "genkit": "^1.28.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.11.1",
    "jsdom": "^26.1.0",
    "node-appwrite": "^29.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "valibot": "^1.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^infra/(.*)$": "<rootDir>/infra/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
