# Core: create your own Appwrite project. Never use the hosted Zetho database.
NODE_ENV=development
PORT=3000
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT=zetho-local
APPWRITE_API_KEY=
APPWRITE_THEMES_BUCKET_ID=zetho-themes
REDIS_URL=redis://localhost:6379
FRONTEND_APP_URL=http://localhost:4200
FRONTEND_APP_URL_EXTRA=
APP_URL=http://localhost:3000

# Optional integrations. Empty credentials leave AI unavailable.
OPENAI_KEY=
GOOGLE_GENAI_KEY=
GAME_RECOMMENDER_MODEL=openai/gpt-5.4
GAME_RECOMMENDER_TIMEOUT_MS=8000
GOOGLE_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Enable only after configuring IGDB; avoids background catalog enrichment locally.
GAME_SEARCH_WORKER_DISABLED=true

# Optional admin/MCP clients and inbound webhooks. Generate separate random secrets.
SYSTEM_API_KEY=
MCP_API_KEY=
APPWRITE_WEBHOOK_SIGNATURE=
IGDB_WEBHOOK_SECRET=

# Optional editorial images and WhatsApp delivery.
EDITOR_AUTHOR_ID=zetho-editor
EDITOR_IMAGES_ENABLED=false
EDITOR_APPROVED_IMAGES={}
EDITOR_NEWS_CAPTURE_WINDOW_HOURS=24
UNSPLASH_ACCESS_KEY=
EVOLUTION_ENDPOINT=
EVOLUTION_INSTANCE_TOKEN=
ZETHO_WPP_CHANNEL=

# Runtime tuning (all have defaults).
APP_CACHE_TTL=60000
APP_CACHE_MAX=1000
LOG_JSON=false
LOG_COLORS=true

# Maintenance commands only; not required to run the app.
DEPLOYMENT_TRIGGER_ENDPOINT=
EDITOR_EVAL_ENV_FILE=
EDITOR_EVAL_WRITING=false
SEARCH_BACKFILL_AFTER=
SEARCH_BACKFILL_EXTERNAL_WORKERS=1
SEARCH_BACKFILL_WORKERS=1
